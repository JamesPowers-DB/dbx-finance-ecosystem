{
  "datasets": [
    {
      "name": "ds_pareto",
      "displayName": "Supplier Pareto (T12M)",
      "queryLines": [
        "WITH base AS (\n",
        "  SELECT supplier_name, MEASURE(total_spend) AS spend\n",
        "  FROM mv_spend\n",
        "  GROUP BY supplier_name\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT\n",
        "    supplier_name,\n",
        "    spend,\n",
        "    SUM(spend) OVER (ORDER BY spend DESC, supplier_name) AS running_sum,\n",
        "    SUM(spend) OVER () AS total_spend\n",
        "  FROM base\n",
        ")\n",
        "SELECT\n",
        "  supplier_name,\n",
        "  spend,\n",
        "  running_sum AS running_spend,\n",
        "  running_sum / total_spend AS cumulative_pct\n",
        "FROM ranked\n",
        "ORDER BY spend DESC, supplier_name;"
      ]
    },
    {
      "name": "81e581c7",
      "displayName": "mv_spend",
      "asset_name": "mv_spend"
    }
  ],
